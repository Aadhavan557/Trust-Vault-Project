# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/trustvault

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiter ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── Blockchain Integration ──────────────────────────
# Set to "true" to enable blockchain document notarization
BLOCKCHAIN_ENABLED=false

# JSON-RPC URL of the EVM node (Hardhat local, Infura, Alchemy, etc.)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Private key of the backend wallet (DO NOT commit real keys!)
# For local Hardhat: use one of the default accounts
BLOCKCHAIN_PRIVATE_KEY=

# Deployed DocumentRegistry contract address
# Run `cd blockchain && npx hardhat run scripts/deploy.js --network localhost`
BLOCKCHAIN_CONTRACT_ADDRESS=

# Human-readable network label
BLOCKCHAIN_NETWORK_NAME=hardhat

# Testnet RPC URLs (optional — used by Hardhat deployment scripts)
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
